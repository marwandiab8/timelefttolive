{
  "name": "time-left-to-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:emulators": "VITE_USE_FIREBASE_EMULATORS=true VITE_FIREBASE_API_KEY=demo-key VITE_FIREBASE_AUTH_DOMAIN=demo-timelefttolive.firebaseapp.com VITE_FIREBASE_PROJECT_ID=demo-timelefttolive VITE_FIREBASE_STORAGE_BUCKET=demo-timelefttolive.appspot.com VITE_FIREBASE_MESSAGING_SENDER_ID=0 VITE_FIREBASE_APP_ID=1:0:web:demo vite --port 5174 --strictPort",
    "build:staging": "vite build --mode staging && node scripts/verify-staging-build.js",
    "preview": "vite preview",
    "backfill:external": "node scripts/backfillExternalDailyItems.js",
    "backfill:life-events": "node scripts/backfillCanonicalLifeEvents.js",
    "enrich:gridline-journals": "node scripts/enrichGridlineJournalLifeEvents.js",
    "sync:calendar-life-events": "node scripts/syncCalendarLifeEvents.js",
    "staging:fixture:create": "node scripts/staging-fixture.js create --project timelefttolive-stg-go --token-file .staging-fixture-token",
    "staging:fixture:cleanup": "node scripts/staging-fixture.js cleanup --project timelefttolive-stg-go --token-file .staging-fixture-token",
    "staging:smoke-test": "node scripts/staging-smoke-test.js --project timelefttolive-stg-go --fixture-token-file .staging-fixture-token",
    "test:staging-build": "node scripts/verify-staging-build.js",
    "test:frontend": "vitest run src --exclude \"functions/**\" --exclude \"scripts/**\" --exclude \"tests/**\"",
    "test:functions": "node --test functions/src/*.test.js functions/src/**/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore-rules.test.cjs tests/firestore-viewer-rules.test.cjs tests/firestore-external-items-rules.test.cjs\"",
    "test:hosting": "firebase emulators:exec --only firestore,functions,hosting \"node --test scripts/verify-hosting-routes.test.cjs\"",
    "test:staging-tools": "node --test scripts/staging-tools.test.mjs",
    "test:all": "npm run test:frontend && npm run test:functions && npm run test:staging-tools && npm run test:rules && npm run test:hosting",
    "test": "npm run test:all"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^14.2.0",
    "vitest": "^3.0.0"
  }
}
