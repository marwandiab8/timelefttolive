rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function calendar(calendarId) {
      return get(/databases/$(database)/documents/lifeCalendars/$(calendarId));
    }

    function isOwner(calendarId) {
      return signedIn() && calendar(calendarId).data.ownerUid == request.auth.uid;
    }

    function isCalendarOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function viewerDoc(calendarId) {
      return get(/databases/$(database)/documents/lifeCalendars/$(calendarId)/viewers/$(request.auth.token.email));
    }

    // Viewer access is keyed by email address, so the token must prove the
    // caller controls that address. Email/password accounts are unverified
    // until the user follows the verification link; Google accounts are verified.
    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isAcceptedViewer(calendarId) {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/lifeCalendars/$(calendarId)/viewers/$(request.auth.token.email))
        && viewerDoc(calendarId).data.status == "accepted"
        && viewerDoc(calendarId).data.role == "viewer";
    }

    function isViewerVisible() {
      return resource.data.visibility == "viewers";
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Collection-group lookup of the caller's own invites (useViewerInvites).
    // The nested match under lifeCalendars/{calendarId} does not apply to
    // collection-group queries, so this needs its own rule. The query must
    // filter on the caller's verified email, so nobody can list other invites.
    match /{path=**}/viewers/{viewerId} {
      allow read: if hasVerifiedEmail() && resource.data.email == request.auth.token.email;
    }

    // Collection-group lookup of linked items across days (the year, month and
    // week views). Nested rules do not apply to collection-group queries, so this
    // repeats the read rule of lifeCalendars/{id}/dailyEntries/{date}/externalItems.
    // The query has to pin the owner, or the calendar plus visibility "viewers",
    // for these conditions to hold. Writes stay with the nested rule.
    match /{path=**}/externalItems/{externalItemId} {
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (isAcceptedViewer(resource.data.calendarId) && resource.data.visibility == "viewers");
    }

    match /lifeCalendars/{calendarId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isCalendarOwner() || isAcceptedViewer(calendarId);
      allow update, delete: if isCalendarOwner();

      match /viewers/{viewerId} {
        allow read: if isOwner(calendarId)
          || (hasVerifiedEmail() && viewerId == request.auth.token.email && resource.data.email == request.auth.token.email)
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update, delete: if isOwner(calendarId);
        allow update: if hasVerifiedEmail()
          && viewerId == request.auth.token.email
          && resource.data.status == "pending"
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid", "status", "acceptedAt"])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "accepted"
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email;
      }

      match /sourceConnections/{connectionId} {
        allow read, write: if isOwner(calendarId);
      }

      match /sourceConnectionSecrets/{connectionId} {
        allow read, write: if false;
      }

      match /externalIndex/{externalItemId} {
        allow read: if isOwner(calendarId);
        allow write: if false;
      }

      match /externalNeedsDateReview/{reviewItemId} {
        allow read, update, delete: if isOwner(calendarId);
        allow create: if false;
      }

      match /lifeEvents/{eventId} {
        allow read: if isOwner(calendarId);
        allow write: if false;
      }

      match /lifeEventTombstones/{eventId} {
        allow read, write: if false;
      }

      match /ingestionDeadLetters/{deadLetterId} {
        allow read, write: if false;
      }

      match /rawIngestionPayloads/{snapshotId} {
        allow read, write: if false;
      }

      match /events/{eventId} {
        allow read: if isOwner(calendarId) || (isAcceptedViewer(calendarId) && isViewerVisible());
        allow write: if isOwner(calendarId);
      }

      match /dailyEntries/{dateId} {
        allow read: if isOwner(calendarId) || (isAcceptedViewer(calendarId) && isViewerVisible());
        allow write: if isOwner(calendarId);

        match /attachments/{attachmentId} {
          allow read: if isOwner(calendarId) || (isAcceptedViewer(calendarId) && isViewerVisible());
          allow write: if isOwner(calendarId);
        }

        match /externalItems/{externalItemId} {
          allow read: if isOwner(calendarId)
            || (signedIn() && resource.data.ownerUid == request.auth.uid)
            || (isAcceptedViewer(calendarId) && resource.data.visibility == "viewers");
          allow write: if isOwner(calendarId);
        }
      }
    }
  }
}
