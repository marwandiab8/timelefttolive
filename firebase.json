{
  "functions": {
    "source": "functions",
    "predeploy": ["node scripts/copy-functions-shared.mjs"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/life-events",
        "function": "apiV1LifeEvents",
        "region": "northamerica-northeast1"
      },
      {
        "source": "/api/v1/life-events:batch",
        "function": "apiV1LifeEventsBatch",
        "region": "northamerica-northeast1"
      },
      {
        "source": "/api/activity/journal-details",
        "function": "getActivityJournalDetails",
        "region": "northamerica-northeast1"
      },
      {
        "source": "/api/activity/media",
        "function": "getActivityMedia",
        "region": "northamerica-northeast1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    }
  }
}
