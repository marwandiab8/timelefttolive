{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/life-events",
        "function": "apiV1LifeEvents",
        "region": "northamerica-northeast1"
      },
      {
        "source": "/api/v1/life-events:batch",
        "function": "apiV1LifeEventsBatch",
        "region": "northamerica-northeast1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
